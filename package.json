{
  "name": "react-foo-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "build:development": "tsc --noEmit && vite build --mode development",
    "build:uat": "tsc --noEmit && vite build --mode uat",
    "build:production": "tsc --noEmit && vite build --mode production",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "api:types": "openapi-typescript \"${OPENAPI_FILE:-../../Nest/nest-foo-studio/openapi.json}\" -o src/api/schema.d.ts",
    "mock:api": "npx --yes @stoplight/prism-cli@5.14.2 mock -p 4010 \"${OPENAPI_FILE:-../../Nest/nest-foo-studio/openapi.json}\""
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "7.13.0",
    "playwright-core": "^1.48.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
