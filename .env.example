# Copy this file to .env. That is the only env file this project has, it is
# gitignored, and it configures LOCAL DEVELOPMENT ONLY — `npm run start`.
#
# ── where the deployed environments are configured ──
# Nowhere yet: Studio has no deploy target. When it gets one, follow
# react-foo-billing and hand the hosts to the app at runtime (its Worker serves
# a /config.js from the `vars` block in wrangler.jsonc), so one build can serve
# development, UAT and production. Do not bring back a tracked .env.<mode> per
# environment — that bakes a host into the bundle and needs a rebuild to change.
#
# The hosts that are already known, for whoever wires that up:
#   Studio API    production   https://api.studio.foocertong.com
#   nest-foo-auth production   https://api-auth.foocertong.com
#   nest-foo-auth development  https://api-auth-development.foocertong.com
# The Studio API has no development or UAT host yet.
#
# No secrets belong in an env file: everything VITE_-prefixed ships in the
# browser bundle. These are configuration, not credentials.

# ── the Studio API (nest-foo-studio) ──
# Absolute, no trailing slash. The API has no /api prefix: routes are
# ${VITE_API_BASE_URL}/portal/... and /health (see openapi.json in
# nest-foo-studio). Locally it listens on 3002.
VITE_API_BASE_URL=http://localhost:3002

# ── nest-foo-auth ──
# The host alone: no /api, no trailing slash — the app calls
# ${VITE_AUTH_URL}/api/auth/... directly. Locally it listens on 3001.
#
# Use `localhost` here, never 127.0.0.1: the refresh cookie from nest-foo-auth
# is SameSite=Lax and only comes back when this app is same-site with the auth
# host. A frontend on localhost is cross-site with a DEPLOYED auth host, so that
# cookie will not come back and every call after sign-in 401s — run
# nest-foo-auth locally for anything that relies on staying signed in.
VITE_AUTH_URL=http://localhost:3001
# Only usable if you are not relying on the refresh cookie:
# VITE_AUTH_URL=https://api-auth-development.foocertong.com

# ── mocks ──
# true while the screens' data comes from the built-in mock API
# (src/api/studio.ts). false makes the screens that are already wired to the
# Studio API above call it — so far the top bar (GET /portal/me, FS-69 / FS-86).
# The rest still read the mock either way.
VITE_USE_MOCK_API=true

# Sign-in goes to nest-foo-auth (email + password). Set true to use the built-in
# demo account instead (mei@kopilane.com / kopilane), e.g. with no auth service
# running.
VITE_USE_MOCK_AUTH=false

# ── ports ──
# This app's dev server runs on http://localhost:5182 and refuses to start if
# that port is taken, so it cannot drift. That origin must be in
# nest-foo-auth's AUTH_PORTAL_ORIGINS as `=studio`, and in the Studio API's
# CORS allowlist.
