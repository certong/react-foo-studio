# Each mode's two backends are named in an env file:
#
#   .env.development   npm run start / build:development
#   .env.uat           npm run build:uat
#   .env.production    npm run build / build:production
#
# `npm run start` is the only dev command; it runs in development mode and so
# reads .env.development. To run against your own backends instead, copy this
# file to .env.development.local (gitignored) — a .env.<mode>.local file wins
# over the tracked .env.<mode>.
#
# No secrets belong in an env file: everything VITE_-prefixed ships in the
# browser bundle. Don't use a plain .env either — vite reads it in every mode,
# builds included, so a localhost value there would reach a deployed bundle.

# Base URL of the Studio API (nest-foo-studio). Absolute, no trailing slash.
# The API has no /api prefix: routes are ${VITE_API_BASE_URL}/portal/... and
# /health (see openapi.json in nest-foo-studio). Locally it listens on 3002.
# VITE_API_BASE_URL=http://localhost:3002

# The host of nest-foo-auth, which owns sign-in (FS-87). Host only: no /api and
# no trailing slash — the app calls ${VITE_AUTH_URL}/api/auth/... directly.
# Locally it listens on 3001.
# VITE_AUTH_URL=http://localhost:3001

# true while the screens' data comes from the built-in mock API (src/api/studio.ts);
# false once they call the Studio API above.
# VITE_USE_MOCK_API=true

# Sign-in goes to nest-foo-auth (email + password). Set true to use the built-in
# demo account instead (mei@kopilane.com / kopilane), e.g. with no auth service running.
# VITE_USE_MOCK_AUTH=false

# --- Running against local backends --------------------------------------------
#
# Use `localhost` everywhere, never 127.0.0.1: the refresh cookie from
# nest-foo-auth is SameSite=Lax and only comes back when this app is same-site
# with the auth host.
#
# This app's dev server runs on http://localhost:5182. That origin must be in
# nest-foo-auth's AUTH_PORTAL_ORIGINS as `=studio`, and in the Studio API's
# CORS allowlist.
